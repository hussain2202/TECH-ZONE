rules_version='2';
service firebase.storage{match /b/{b}/o{
  match /products/{f=**}{allow read:if true;allow write:if request.auth!=null&&request.auth.token.admin==true&&request.resource.size<5*1024*1024&&request.resource.contentType.matches('image/.*')}
  match /avatars/{uid}/{f}{allow read:if true;allow write:if request.auth!=null&&request.auth.uid==uid&&request.resource.size<2*1024*1024&&request.resource.contentType.matches('image/.*')}
}}
