rules_version='2';
service cloud.firestore{match /databases/{db}/documents{
  function admin(){return request.auth!=null&&request.auth.token.admin==true}
  match /products/{id}{allow read:if true;allow write:if admin()}
  match /categories/{id}{allow read:if true;allow write:if admin()}
  match /banners/{id}{allow read:if true;allow write:if admin()}
  match /settings/{id}{allow read:if true;allow write:if admin()}
  match /coupons/{id}{allow get:if true;allow list,write:if admin()}  // code is the doc id; values are validated again on the server
  match /reviews/{id}{allow read:if resource.data.approved==true||admin();allow create:if request.auth!=null&&request.resource.data.approved==false;allow update,delete:if admin()}
  match /users/{uid}{allow read:if request.auth!=null&&(request.auth.uid==uid||admin());allow create,update:if request.auth!=null&&request.auth.uid==uid&&request.resource.data.keys().hasOnly(['name','email','phone','photoURL','createdAt'])}
  match /carts/{uid}{allow read,write:if request.auth!=null&&request.auth.uid==uid}
  function mine(uid){return request.auth!=null&&request.auth.uid==uid}
  function okList(n){return request.resource.data.keys().hasOnly(['items','updatedAt'])&&request.resource.data.items is list&&request.resource.data.items.size()<=n}
  match /wishlists/{uid}{allow read,delete:if mine(uid);allow create,update:if mine(uid)&&okList(200)}
  match /comparisons/{uid}{allow read,delete:if mine(uid);allow create,update:if mine(uid)&&okList(4)}
  match /addresses/{uid}{allow read,delete:if mine(uid);allow create,update:if mine(uid)&&okList(10)}
  // Orders are created ONLY by the Cloud Function (Admin SDK bypasses rules). Clients can only read their own.
  match /orders/{id}{allow read:if request.auth!=null&&(resource.data.uid==request.auth.uid||admin());allow update:if admin();allow create,delete:if false}
  match /newsletter/{id}{allow create:if request.resource.data.keys().hasOnly(['email','createdAt']);allow read:if admin()}
  match /messages/{id}{allow create:if true;allow read,update,delete:if admin()}
}}
